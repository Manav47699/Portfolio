# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Lucky (chatbot) -------------------------------------------------------
# At least one provider is recommended. Without any, Lucky still answers by
# quoting the most relevant knowledge-base entries (no AI phrasing).

# Groq: free tier, very fast. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Google Gemini: optional backup if Groq is rate-limited. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Any other OpenAI-compatible API (OpenRouter, Together, OpenAI…): optional
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Contact form ------------------------------------------------------------
# Resend: free tier, 3,000 emails/month. https://resend.com/api-keys
RESEND_API_KEY=
# CONTACT_TO_EMAIL=acharyamanav7@gmail.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
